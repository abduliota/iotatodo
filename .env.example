# ── NextAuth ──────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=http://localhost:3000

# ── Atlassian OAuth 2.0 ───────────────────────────────────────────────────────
# Register your app at: https://developer.atlassian.com/console/myapps/
# Set callback URL to: http://localhost:3000/api/auth/callback/atlassian
ATLASSIAN_CLIENT_ID=your_atlassian_client_id
ATLASSIAN_CLIENT_SECRET=your_atlassian_client_secret

# ── Jira Config ───────────────────────────────────────────────────────────────
# The Jira project key your app will manage (e.g. IOTA, TODO, DEV)
NEXT_PUBLIC_JIRA_PROJECT_KEY=IOTA
